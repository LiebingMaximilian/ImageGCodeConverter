# Server configuration for the ImageConverter container.
# Lives at /etc/imageconverter/imageconverter.env (created by setup-server.sh, never overwritten).
# After editing: redeploy, or run  sudo /usr/local/bin/imageconverter-deploy restart

# Image in the GitHub container registry (lowercase!): ghcr.io/<github-user>/imageconverter
IMAGECONVERTER_IMAGE=ghcr.io/your-github-user/imageconverter

# Host port the app is published on – pick one that is free on your server.
IMAGECONVERTER_PORT=5080

# 127.0.0.1 = only reachable through your reverse proxy on this server (recommended)
# 0.0.0.0   = reachable from outside on IMAGECONVERTER_PORT (the app has no login!)
IMAGECONVERTER_BIND=127.0.0.1

# Resource limits, so conversions can't slow down your other apps.
IMAGECONVERTER_CPUS=2
IMAGECONVERTER_MEMORY=4g

# Optional app settings (ASP.NET configuration via environment variables):
# TspDefaults__AutoPixelsPerPoint=20
# TspDefaults__AutoMaxPoints=1000000
