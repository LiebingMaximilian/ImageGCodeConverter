# Files that run on the Linux server must keep LF line endings,
# even when checked out on Windows with core.autocrlf=true.
*.sh       text eol=lf
*.service  text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
deploy/imageconverter-deploy   text eol=lf
deploy/*.env.example           text eol=lf
Dockerfile                     text eol=lf
