{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ImageConverter.App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-app",
      "program": "${workspaceFolder}/src/ImageConverter.App/bin/Debug/net10.0-windows/ImageConverter.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/ImageConverter.App",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Debug ImageConverter.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/src/ImageConverter.Web/bin/Debug/net10.0/ImageConverter.Web.dll",
      "cwd": "${workspaceFolder}/src/ImageConverter.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}